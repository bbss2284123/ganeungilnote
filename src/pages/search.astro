---
import Base from "../layouts/Base.astro";
import { siteConfig } from "../../site.config";
---
<Base title="검색" description={`${siteConfig.name} 글 검색`} path="/search/" current="search" noindex>
  <main id="content" class="wrap page-narrow search-page" data-pagefind-body>
    <h1>검색</h1>
    <p>제목과 본문에서 찾습니다. 발행된 글과 안내 페이지만 색인에 들어갑니다.</p>
    <form class="search-bar" action="/search/" method="get">
      <input id="q" type="search" name="q" placeholder="여행지 · 축제 · 주차장 검색" aria-label="검색어" />
      <button type="submit" aria-label="검색">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="#fff" stroke-width="2"/><path d="M16 16l5 5" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </form>
    <div id="out"></div>
  </main>
</Base>
<script is:inline>
  const input = document.querySelector("#q");
  const out = document.querySelector("#out");
  const params = new URLSearchParams(location.search);
  if (params.get("q") && input instanceof HTMLInputElement) input.value = params.get("q") ?? "";
  async function run() {
    if (!out || !(input instanceof HTMLInputElement)) return;
    const query = input.value.trim();
    if (!query) {
      out.textContent = "검색어를 입력하세요.";
      return;
    }
    try {
      const pagefind = await import("/pagefind/pagefind.js");
      const found = await pagefind.search(query);
      const rows = await Promise.all(found.results.slice(0, 8).map((row) => row.data()));
      out.replaceChildren();
      if (!rows.length) {
        const empty = document.createElement("p");
        empty.textContent = "해당하는 글이 없습니다.";
        out.append(empty);
        return;
      }
      for (const row of rows) {
        const box = document.createElement("article");
        box.className = "result";
        const link = document.createElement("a");
        link.href = row.url;
        link.textContent = row.meta.title || row.url;
        const excerpt = document.createElement("p");
        excerpt.innerHTML = row.excerpt;
        box.append(link, excerpt);
        out.append(box);
      }
    } catch {
      out.textContent = "검색 색인은 사이트를 빌드한 뒤에 생깁니다.";
    }
  }
  input?.addEventListener("change", run);
  input?.addEventListener("input", () => {
    if (input instanceof HTMLInputElement && input.value.trim() === "" && out) out.textContent = "";
  });
  if (input instanceof HTMLInputElement && input.value) run();
</script>
