---
import "../styles/global.css";
import { siteConfig, absoluteUrl } from "../../site.config";
import Seo from "../components/Seo.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  type?: "website" | "article";
  jsonLd?: unknown[];
  published?: string;
  modified?: string;
  current?: string;
  noindex?: boolean;
}
const { title, description, path, ogImage, type = "website", jsonLd = [], published, modified, current = "", noindex = false } = Astro.props;
const canonical = absoluteUrl(path);
const more = [
  { href: "/about/", label: "소개" },
  { href: "/contact/", label: "문의" },
  { href: "/sources/", label: "출처·정정 안내" },
  { href: "/privacy/", label: "개인정보처리방침" },
  { href: "/terms/", label: "이용약관" },
];
---
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={siteConfig.design.brand} />
    <link rel="preload" href="/fonts/pretendard/Pretendard-Regular.subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/pretendard/Pretendard-Bold.subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/pretendard/pretendard.css" />
    <Seo title={title} description={description} canonical={canonical} ogImage={ogImage} type={type} published={published} modified={modified} jsonLd={jsonLd} noindex={noindex} />
  </head>
  <body>
    <a class="skip" href="#content">본문으로</a>
    <header class="site-header">
      <div class="header-bar">
        <a class="brand" href="/">
          <img src="/brand/logo-horizontal.png" alt="가는길노트" width="1080" height="200" />
        </a>
        <p class="tagline">{siteConfig.tagline}</p>
        <div class="header-tools">
          <button class="icon-btn" type="button" data-open-search aria-label="검색">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 16l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="메뉴">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </div>
      </div>
      <nav class="main-nav" aria-label="주요">
        {siteConfig.nav.map((item) => (
          <a class:list={{ "is-on": item.match.includes(current) }} href={item.href} aria-current={item.match.includes(current) ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
      <div class="mobile-search">
        <form action="/search/" method="get">
          <input type="search" name="q" placeholder="여행지 · 축제 · 주차장 검색" aria-label="검색어" />
          <button type="submit" aria-label="검색">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="#fff" stroke-width="2"/><path d="M16 16l5 5" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </form>
      </div>
      <div id="site-menu" class="menu-panel" hidden>
        <nav class="primary-mobile" aria-label="모바일 주요">
          {siteConfig.nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
        <nav aria-label="안내">
          {more.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-brand">{siteConfig.slogan}</p>
        <nav class="footer-cats" aria-label="분류">
          {siteConfig.categories.map((category) => (
            <a href={`/category/${category.id}/`}>{category.name}</a>
          ))}
        </nav>
        <nav class="footer-links" aria-label="안내">
          <a href="/about/">소개</a>
          <a href="/contact/">문의</a>
          <a href="/sources/">출처·정정 안내</a>
          <a href="/privacy/">개인정보처리방침</a>
          <a href="/terms/">이용약관</a>
          <a href="/archive/">전체 글</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <p class="legal">© {new Date().getFullYear()} {siteConfig.name} · ganeungilnote.com</p>
      </div>
    </footer>
    <dialog id="search-dialog" class="search-dialog">
      <form action="/search/" method="get">
        <h2>검색</h2>
        <div class="search-bar">
          <input type="search" name="q" placeholder="여행지 · 축제 · 주차장 검색" aria-label="검색어" />
          <button type="submit" aria-label="검색">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="#fff" stroke-width="2"/><path d="M16 16l5 5" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </div>
      </form>
    </dialog>
    <script is:inline>
      const menuButton = document.querySelector(".menu-toggle");
      const menu = document.querySelector("#site-menu");
      menuButton?.addEventListener("click", () => {
        const open = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!open));
        if (menu) menu.hidden = open;
      });
      const searchDialog = document.querySelector("#search-dialog");
      document.querySelector("[data-open-search]")?.addEventListener("click", () => {
        if (!(searchDialog instanceof HTMLDialogElement)) return;
        searchDialog.showModal();
        searchDialog.querySelector("input")?.focus();
      });
      searchDialog?.addEventListener("click", (event) => {
        if (event.target === searchDialog && searchDialog instanceof HTMLDialogElement) searchDialog.close();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu && menuButton) {
          menu.hidden = true;
          menuButton.setAttribute("aria-expanded", "false");
        }
      });
    </script>
    <script is:inline>(function(){function s(){try{var p=location.pathname;if(window.__mgsP===p)return;window.__mgsP=p;var u="https://mgs-counter.seedleaf11.workers.dev/hit",d=JSON.stringify({h:location.hostname,p:p});if(navigator.sendBeacon&&navigator.sendBeacon(u,new Blob([d],{type:"text/plain"})))return;fetch(u,{method:"POST",body:d,keepalive:true,mode:"no-cors",credentials:"omit"})}catch(e){}}s();document.addEventListener("astro:page-load",s)})();</script>
    <noscript><img src={`https://mgs-counter.seedleaf11.workers.dev/hit.gif?p=${encodeURIComponent(Astro.url.pathname)}`} width="1" height="1" alt="" referrerpolicy="strict-origin-when-cross-origin" style="position:absolute;width:1px;height:1px;left:-9999px" /></noscript>
  </body>
</html>
