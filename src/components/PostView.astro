---
import Base from "../layouts/Base.astro";
import Sidebar from "./Sidebar.astro";
import AdSlot from "./mdx/AdSlot.astro";
import SummaryTable from "./post/SummaryTable.astro";
import ParkingTable from "./post/ParkingTable.astro";
import TransportGuide from "./post/TransportGuide.astro";
import RouteMap from "./post/RouteMap.astro";
import RestaurantCards from "./post/RestaurantCards.astro";
import Cautions from "./post/Cautions.astro";
import SourcesBlock from "./post/SourcesBlock.astro";
import Figures from "./post/Figures.astro";
import { categoryById, siteConfig, absoluteUrl } from "../../site.config";
import { authorName, categoryName, categoryPath, postPath, publishDate, tagLabel, tagPath, type PostEntry } from "../lib/posts";
import { postOgImage, seoulIso } from "../lib/seo";

interface Props {
  post: PostEntry;
  // Astro가 render()로 넘기는 MDX 컴포넌트
  Content: any;
  related: PostEntry[];
  published: PostEntry[];
  prev?: PostEntry;
  next?: PostEntry;
}
const { post, Content, related, published, prev, next } = Astro.props;
const data = post.data;
const category = categoryById(data.category);
const noindex = data.draft || data.sample;
const figures = data.figures ?? [];
const story = data.body_layout === "story";
const faq = data.faq ?? [];
const anchors = story && data.story_anchors ? data.story_anchors.map((item) => [item.href, item.label]) : story ? [
  ["#summary", "한눈에"],
  ["#hours", "점등 시간"],
  ["#transport", "가는 법"],
  ["#parking", "주차장"],
  ["#route", "걷는 길"],
  ["#facilities", "편의시설"],
  ["#caution", "방문 전"],
  ["#sources", "출처"],
] : [
  ["#summary", "한눈에"],
  ["#transport", "찾아가는 법"],
  ["#parking", "주차장"],
  ...(data.route_map ? [["#route", "동선"]] : []),
  ...(data.restaurants.length ? [["#food", "맛집"]] : []),
  ["#caution", "방문 전 주의"],
  ["#sources", "출처"],
  ["#related", "관련 글"],
];
const ogImage = noindex ? (data.hero_image ?? undefined) : postOgImage(post.id);
const publishedIso = seoulIso(data.published_at ?? publishDate(post));
const modifiedIso = seoulIso(data.updated > publishDate(post).slice(0, 10) ? data.updated : publishDate(post));
const pageUrl = absoluteUrl(postPath(post.id));
const images = [ogImage, data.hero_image].filter((src): src is string => Boolean(src)).map((src) => absoluteUrl(src));
const jsonLd = noindex ? [] : [{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: data.title,
  description: data.description,
  image: [...new Set(images)],
  datePublished: publishedIso,
  dateModified: modifiedIso,
  inLanguage: "ko",
  author: { "@type": "Organization", name: authorName(post), url: siteConfig.url },
  publisher: {
    "@type": "Organization",
    name: siteConfig.name,
    url: siteConfig.url,
    logo: { "@type": "ImageObject", url: absoluteUrl("/brand/symbol-512.png") },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  articleSection: categoryName(data.category),
  keywords: data.tags.map((tag) => tagLabel(tag)).join(", "),
}, {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "홈", item: absoluteUrl("/") },
    { "@type": "ListItem", position: 2, name: categoryName(data.category), item: absoluteUrl(categoryPath(data.category)) },
    { "@type": "ListItem", position: 3, name: data.title, item: pageUrl },
  ],
}, ...(faq.length ? [{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
}] : [])];
---
<Base
  title={data.title}
  description={data.description}
  path={noindex ? `/draft/${post.id}/` : postPath(post.id)}
  ogImage={ogImage}
  type="article"
  current={data.category}
  noindex={noindex}
  published={noindex ? undefined : publishedIso}
  modified={noindex ? undefined : modifiedIso}
  jsonLd={jsonLd}
>
  <main id="content" class="wrap">
    <div class="home-grid">
      <article class="main-col article" data-pagefind-body={noindex ? undefined : true}>
        {(data.sample || data.draft) && (
          <p class="sample-banner">예시·미검증 · 발행되지 않은 초안. 요금·시간·거리·평점을 사실로 읽지 마세요.</p>
        )}
        <header class="article-head">
          <p class="kicker">
            <a href={categoryPath(data.category)}>{categoryName(data.category)}</a>
            {data.region ? ` · ${data.region}` : ""}
          </p>
          <h1>{data.title}</h1>
          <p class="caption">{authorName(post)}</p>
          <div class="chip-row">
            {data.tags.map((tag) => <a class="chip" href={tagPath(tag)}>{tagLabel(tag)}</a>)}
          </div>
        </header>
        {data.hero_image && (
          <figure class="post-hero">
            <a class="zoomable" href={data.hero_image} data-zoom aria-label={`${data.hero_alt ?? data.title} 크게 보기`}>
              <img src={data.hero_image} alt={data.hero_alt ?? ""} width="1200" height="675" loading="eager" fetchpriority="high" decoding="async" />
            </a>
          </figure>
        )}
        <div class="lede">
          {data.lede.map((line) => <p>{line}</p>)}
        </div>
        <nav class="anchors" aria-label="본문 바로가기">
          {anchors.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
        <AdSlot position="after-intro" />
        <div class:list={["prose", { story }]}>
          <Content />
        </div>
        {!story && (
          <>
            <SummaryTable summary={data.summary}><Figures items={figures} section="summary" /></SummaryTable>
            <TransportGuide car={data.transport.car} walk={data.transport.walk} rail={data.transport.rail}><Figures items={figures} section="transport" /></TransportGuide>
            <ParkingTable lots={data.parking_lots}><Figures items={figures} section="parking" /></ParkingTable>
            {data.route_map && <RouteMap map={data.route_map} sample={data.sample} />}
            {data.restaurants.length > 0 && <RestaurantCards restaurants={data.restaurants} />}
            <Cautions items={data.cautions}><Figures items={figures} section="caution" /></Cautions>
          </>
        )}
        {faq.length > 0 && (
          <section id="faq" class="faq" aria-labelledby="faq-title">
            <h2 id="faq-title">자주 묻는 질문</h2>
            {faq.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </section>
        )}
        <AdSlot position="end" />
        <SourcesBlock sources={data.sources} />
        <section id="related" aria-labelledby="related-title">
          <h2 id="related-title">관련 글</h2>
          {related.length === 0 ? (
            <p class="unknown">같은 지역·분류의 발행 글이 아직 없습니다.</p>
          ) : (
            <div class="related">
              {related.map((item) => <a href={postPath(item.id)}>{item.data.title}</a>)}
            </div>
          )}
          {(prev || next) && (
            <p>
              {prev && <a href={postPath(prev.id)}>이전 {prev.data.title}</a>}
              {next && <a href={postPath(next.id)}>다음 {next.data.title}</a>}
            </p>
          )}
        </section>
        {category && <p class="caption">{category.description}</p>}
      </article>
      <Sidebar posts={published} />
    </div>
  </main>
  <div class="zoom-layer" hidden><img alt="" /><button type="button" class="zoom-close" aria-label="닫기">×</button></div>
  <script is:inline>
    (() => {
      const layer = document.querySelector(".zoom-layer");
      if (!layer) return;
      const img = layer.querySelector("img");
      const close = () => { layer.hidden = true; img.removeAttribute("src"); document.body.style.overflow = ""; };
      document.addEventListener("click", (event) => {
        const link = event.target.closest && event.target.closest("a[data-zoom]");
        if (link) {
          event.preventDefault();
          const inner = link.querySelector("img");
          img.src = link.getAttribute("href");
          img.alt = inner ? inner.alt : "";
          layer.hidden = false;
          document.body.style.overflow = "hidden";
        } else if (!layer.hidden && layer.contains(event.target)) {
          close();
        }
      });
      document.addEventListener("keydown", (event) => { if (event.key === "Escape" && !layer.hidden) close(); });
    })();
  </script>
</Base>
