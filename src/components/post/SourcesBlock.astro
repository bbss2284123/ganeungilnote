---
import { UNKNOWN } from "../../lib/display";
import type { PostFrontmatter } from "../../lib/post-schema";

interface Props { sources: PostFrontmatter["sources"]; }
const { sources } = Astro.props;
---
<section id="sources" aria-labelledby="sources-title">
  <h2 id="sources-title">출처</h2>
  {sources.length === 0 ? (
    <p class="unknown">{UNKNOWN}</p>
  ) : (
    <ul class="sources">
      {sources.map((source) => (
        <li><a href={source.url} rel="noopener noreferrer">{source.title}</a></li>
      ))}
    </ul>
  )}
</section>
