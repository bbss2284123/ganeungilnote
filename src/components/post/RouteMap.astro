---
import type { PostFrontmatter } from "../../lib/post-schema";

interface Props { map: PostFrontmatter["route_map"]; sample?: boolean; }
const { map, sample = false } = Astro.props;
---
<section id="route" aria-labelledby="route-title">
  <h2 id="route-title">동선 지도</h2>
  {!map ? (
    <p class="unknown">확인되지 않음</p>
  ) : (
    <figure class="route-fig">
      {map.src ? (
        <a class="zoomable" href={map.src} data-zoom aria-label={`${map.alt} 크게 보기`}><img src={map.src} alt={map.alt} width="1200" height="980" loading="lazy" decoding="async" /></a>
      ) : (
        <div class="schematic" role="img" aria-label={map.alt}>
          {sample && <p class="sample-flag">예시·미검증</p>}
          <p class="schematic-flag">개념도·축척 없음</p>
          <div class="node">예시역<small>출발</small></div>
          <div class="node">예시마당<small>방문지</small></div>
          <div class="node">예시식당<small>식당</small></div>
          <div class="node p1">P1<small>주차장</small></div>
          <div class="node p2">P2<small>주차장</small></div>
          <div class="node p3">P3<small>주차장</small></div>
        </div>
      )}
      {!map.src && (
        <figcaption>
          {map.schematic ? "개념도·축척 없음. " : ""}
          {map.caption ?? "확인되지 않음"}
        </figcaption>
      )}
      {map.src && map.caption && <figcaption>{map.caption}</figcaption>}
    </figure>
  )}
</section>
